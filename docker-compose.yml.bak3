services:
  zookeeper:
    image: confluentinc/cp-zookeeper:7.5.0
    container_name: zookeeper
    environment:
      ZOOKEEPER_CLIENT_PORT: 2181
      ZOOKEEPER_TICK_TIME: 2000
    ports:
      - "2181:2181"
    networks:
      - banco-net

  kafka:
    image: confluentinc/cp-kafka:7.5.0
    container_name: kafka
    depends_on:
      - zookeeper
    ports:
      - "9092:9092"
    environment:
      KAFKA_BROKER_ID: 1
      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:29092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
      KAFKA_HEAP_OPTS: "-Xmx512M -Xms256M"
    restart: on-failure
    networks:
      - banco-net

  config-server:
    build: ./config-server
    container_name: config-server
    ports:
      - "8888:8888"
    volumes:
      - ./config-repo:/app/config-repo
    networks:
      - banco-net

  eureka-server:
    build: ./eureka-server
    container_name: eureka-server
    ports:
      - "8761:8761"
    depends_on:
      - config-server
    networks:
      - banco-net

  auth-server:
    build: ./auth-server
    container_name: auth-server
    ports:
      - "9000:9000"
    depends_on:
      - eureka-server
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://eureka-server:8761/eureka/
    networks:
      - banco-net

  microservicio-transacciones:
    build: ./microservicio-transacciones
    container_name: microservicio-transacciones
    ports:
      - "8081:8081"
    depends_on:
      - kafka
      - eureka-server
      - auth-server
    restart: on-failure
    environment:
      SPRING_KAFKA_BOOTSTRAP_SERVERS: kafka:9092
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://eureka-server:8761/eureka/
      SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI: http://auth-server:9000
    networks:
      - banco-net

  microservicio-cuentas:
    build: ./microservicio-cuentas
    container_name: microservicio-cuentas
    ports:
      - "8082:8082"
    depends_on:
      - kafka
      - eureka-server
      - auth-server
    restart: on-failure
    environment:
      SPRING_KAFKA_BOOTSTRAP_SERVERS: kafka:9092
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://eureka-server:8761/eureka/
      SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI: http://auth-server:9000
    networks:
      - banco-net

  microservicio-pagos:
    build: ./microservicio-pagos
    container_name: microservicio-pagos
    ports:
      - "8085:8085"
    depends_on:
      - kafka
      - eureka-server
      - auth-server
    restart: on-failure
    environment:
      SPRING_KAFKA_BOOTSTRAP_SERVERS: kafka:9092
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://eureka-server:8761/eureka/
      SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI: http://auth-server:9000
    networks:
      - banco-net

  microservicio-clientes:
    build: ./microservicio-clientes
    container_name: microservicio-clientes
    ports:
      - "8086:8086"
    depends_on:
      - eureka-server
      - auth-server
    restart: on-failure
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://eureka-server:8761/eureka/
      SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI: http://auth-server:9000
    networks:
      - banco-net

  bff-web:
    build: ./bff-web
    container_name: bff-web
    ports:
      - "8080:8080"
    depends_on:
      - microservicio-transacciones
      - microservicio-cuentas
      - auth-server
      - eureka-server
    restart: on-failure
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://eureka-server:8761/eureka/
      SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI: http://auth-server:9000
    networks:
      - banco-net

  bff-movil:
    build: ./bff-movil
    container_name: bff-movil
    ports:
      - "8083:8083"
    depends_on:
      - microservicio-transacciones
      - auth-server
      - eureka-server
    restart: on-failure
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://eureka-server:8761/eureka/
      SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI: http://auth-server:9000
    networks:
      - banco-net
    
  bff-atm:
    build: ./bff-atm
    container_name: bff-atm
    ports:
      - "8084:8084"
    depends_on:
      - microservicio-cuentas
      - auth-server
      - eureka-server
    restart: on-failure
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://eureka-server:8761/eureka/
      SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI: http://auth-server:9000
    networks:
      - banco-net

  batch-service:
    build: ./batch-service
    container_name: batch-service
    environment:
      CONFIG_SERVER_URI: http://config-server:8888
      EUREKA_URI: http://eureka-server:8761/eureka
      SPRING_PROFILES_ACTIVE: local
    ports:
      - "8087:8087"
    depends_on:
      - config-server
      - eureka-server
    networks:
      - banco-net
    restart: unless-stopped

networks:
  banco-net:
    driver: bridge
